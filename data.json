import json
import os
import re
import feedparser
from datetime import datetime, timedelta, timezone

OUTPUT_FILE = "data.json"

FEEDS = [
    ("Hyderabad", "https://news.google.com/rss/search?q=Hyderabad+pharma+API+CDMO&hl=en-IN&gl=IN&ceid=IN:en"),
    ("Vizag / AP", "https://news.google.com/rss/search?q=Andhra+Pradesh+pharma+bulk+drugs+API&hl=en-IN&gl=IN&ceid=IN:en"),
    ("India", "https://news.google.com/rss/search?q=India+pharma+API+manufacturing&hl=en-IN&gl=IN&ceid=IN:en"),
    ("Global", "https://news.google.com/rss/search?q=global+pharma+API+FDA+CDMO&hl=en-IN&gl=IN&ceid=IN:en"),
]

KEYWORDS = [
    "pharma",
    "pharmaceutical",
    "api",
    "intermediate",
    "bulk drug",
    "cdmo",
    "manufacturing",
    "drug",
    "chemical",
    "fda",
    "investment",
    "plant",
    "expansion",
    "pli",
]

def clean_text(text):
    text = re.sub("<[^>]+>", "", text or "")
    return re.sub(r"\s+", " ", text).strip()


def classify(title, summary):
    text = (title + " " + summary).lower()

    if any(x in text for x in [
        "investment",
        "invest",
        "expansion",
        "new plant",
        "capacity",
        "pli",
    ]):
        signal = "Opportunity"
        priority = "High Priority"

    elif any(x in text for x in [
        "cdmo",
        "contract manufacturing",
        "outsourcing",
    ]):
        signal = "Opportunity"
        priority = "Medium Priority"

    elif any(x in text for x in [
        "api",
        "intermediate",
        "bulk drug",
    ]):
        signal = "Opportunity"
        priority = "Medium Priority"

    elif any(x in text for x in [
        "fda",
        "ema",
        "approval",
        "regulatory",
    ]):
        signal = "Watch"
        priority = "Medium Priority"

    else:
        signal = "Watch"
        priority = "Low Priority"

    return signal, priority


def why_it_matters(signal):
    if signal == "Opportunity":
        return (
            "This development may create potential customer, supplier, "
            "manufacturing, sourcing or partnership opportunities."
        )

    return (
        "This industry development should be monitored for possible "
        "business impact."
    )


def md_action(signal):
    if signal == "Opportunity":
        return (
            "Track the development and evaluate relevant customer, "
            "supplier, product or partnership opportunities."
        )

    return "Monitor for further developments."


def get_articles():
    articles = []
    cutoff = datetime.now(timezone.utc) - timedelta(hours=24)

    for region, url in FEEDS:
        try:
            feed = feedparser.parse(url)

            for entry in feed.entries:
                title = clean_text(entry.get("title", ""))
                link = entry.get("link", "")
                summary = clean_text(entry.get("summary", ""))

                if not title or not link:
                    continue

                combined = (title + " " + summary).lower()

                if not any(keyword in combined for keyword in KEYWORDS):
                    continue

                published = entry.get("published_parsed")

                if published:
                    published_dt = datetime(
                        published.tm_year,
                        published.tm_mon,
                        published.tm_mday,
                        published.tm_hour,
                        published.tm_min,
                        published.tm_sec,
                        tzinfo=timezone.utc,
                    )

                    if published_dt < cutoff:
                        continue

                signal, priority = classify(title, summary)

                articles.append({
                    "title": title,
                    "link": link,
                    "category": region,
                    "signal": signal,
                    "priority": priority,
                    "why_it_matters": why_it_matters(signal),
                    "md_action": md_action(signal),
                })

        except Exception as error:
            print(f"Feed error for {region}: {error}")


    # Remove duplicate headlines
    unique = {}
    for article in articles:
        key = article["title"].lower().strip()
        unique[key] = article

    return list(unique.values())


def build_dashboard():
    articles = get_articles()

    opportunity_count = sum(
        1 for x in articles if x["signal"] == "Opportunity"
    )

    risk_count = sum(
        1 for x in articles if x["signal"] == "Risk"
    )

    high_priority_count = sum(
        1 for x in articles if x["priority"] == "High Priority"
    )

    must_know = [
        x for x in articles
        if x["priority"] == "High Priority"
    ]

    business_signals = {
        "API / Intermediates": sum(
            1 for x in articles
            if "api" in x["title"].lower()
            or "intermediate" in x["title"].lower()
            or "bulk drug" in x["title"].lower()
        ),

        "CDMO": sum(
            1 for x in articles
            if "cdmo" in x["title"].lower()
            or "contract manufacturing" in x["title"].lower()
        ),

        "Manufacturing": sum(
            1 for x in articles
            if "manufacturing" in x["title"].lower()
            or "plant" in x["title"].lower()
            or "expansion" in x["title"].lower()
        ),

        "Supply Chain": sum(
            1 for x in articles
            if "supply" in x["title"].lower()
            or "logistics" in x["title"].lower()
        ),

        "Regulatory": sum(
            1 for x in articles
            if "fda" in x["title"].lower()
            or "ema" in x["title"].lower()
            or "regulatory" in x["title"].lower()
            or "approval" in x["title"].lower()
        ),
    }

    data = {
        "company": "Sri Aditya Pharmachem",
        "title": "MD Pharma Intelligence",
        "period": "Last 24 hours",

        "article_count": len(articles),
        "opportunity_count": opportunity_count,
        "risk_count": risk_count,
        "high_priority_count": high_priority_count,

        "must_know": must_know[:5],
        "articles": articles,

        "business_signals": business_signals,

        "updated": datetime.now(timezone.utc).isoformat(),
    }

    with open(OUTPUT_FILE, "w", encoding="utf-8") as file:
        json.dump(data, file, indent=2, ensure_ascii=False)

    print("data.json updated successfully")
    print(f"Articles: {len(articles)}")
    print(f"Opportunities: {opportunity_count}")
    print(f"Risks: {risk_count}")
    print(f"High Priority: {high_priority_count}")


if __name__ == "__main__":
    build_dashboard()
