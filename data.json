/*
  Sri Aditya Pharmachem - MD Intelligence frontend
  Reads data.json (written by news.py via GitHub Actions) and fills the page.

  Add to index.html, just before </body>:
      <script src="app.js"></script>

  Add data-field="..." attributes to the elements you want filled in.
  See the list of names below - each matches one piece of data.json.
*/

async function loadDashboard() {
  try {
    const res = await fetch('data.json?_=' + Date.now()); // cache-bust, never show stale data
    if (!res.ok) throw new Error('data.json not found');
    const data = await res.json();

    // ---- KPI counts (top of page) ----
    setText('news_detected', data.article_count);
    setText('opportunities', data.opportunity_count);
    setText('risks', data.risk_count);
    setText('high_priority', data.high_priority_count);

    // ---- Last updated time ----
    setText('updated_at', formatTime(data.updated));

    // ---- Must Know (top priority items) ----
    renderCards('must_know', data.must_know);

    // ---- Regional sections, filtered from the full articles list ----
    const regions = groupByRegion(data.articles);
    renderCards('region_hyderabad', regions.hyderabad);
    renderCards('region_vizag', regions.vizag);
    renderCards('region_india', regions.india);
    renderCards('region_global', regions.global);

    // ---- Business signals (API/Intermediates, CDMO, etc.) ----
    renderSignals('business_signals', data.business_signals);

  } catch (err) {
    console.error('Dashboard load failed:', err);
  }
}

// Sorts every article into one of the four region buckets based on its
// "category" field (works even if news.py's exact wording shifts slightly).
function groupByRegion(articles) {
  const out = { hyderabad: [], vizag: [], india: [], global: [] };
  (articles || []).forEach(item => {
    const c = (item.category || '').toLowerCase();
    if (c.includes('hyderabad')) out.hyderabad.push(item);
    else if (c.includes('vizag') || c.includes('ap')) out.vizag.push(item);
    else if (c.includes('india')) out.india.push(item);
    else if (c.includes('global')) out.global.push(item);
  });
  return out;
}

function renderCards(fieldName, items) {
  const el = document.querySelector(`[data-field="${fieldName}"]`);
  if (!el) return;
  if (!items || items.length === 0) {
    el.innerHTML = '<p class="empty">No items in the last 24 hours.</p>';
    return;
  }
  el.innerHTML = items.map(item => `
    <div class="card">
      <span class="tag tag-${(item.signal || '').toLowerCase()}">${item.signal || ''}</span>
      <a href="${item.link}" target="_blank" rel="noopener"><strong>${item.title}</strong></a>
      ${item.why_it_matters ? `<div class="why"><b>Why it matters:</b> ${item.why_it_matters}</div>` : ''}
      ${item.md_action ? `<div class="action"><b>Action:</b> ${item.md_action}</div>` : ''}
    </div>
  `).join('');
}

function renderSignals(fieldName, signals) {
  const el = document.querySelector(`[data-field="${fieldName}"]`);
  if (!el || !signals) return;
  const max = Math.max(1, ...Object.values(signals));
  el.innerHTML = Object.entries(signals).map(([label, count]) => `
    <div class="signal-row">
      <span class="signal-label">${label}</span>
      <div class="signal-track"><div class="signal-fill" style="width:${(count / max) * 100}%"></div></div>
      <span class="signal-count">${count}</span>
    </div>
  `).join('');
}

function setText(fieldName, value) {
  const el = document.querySelector(`[data-field="${fieldName}"]`);
  if (el) el.textContent = value;
}

function formatTime(isoString) {
  if (!isoString) return '';
  return new Date(isoString).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' });
}

loadDashboard();
setInterval(loadDashboard, 5 * 60 * 1000); // re-check data.json every 5 minutes
