 MD Pharma Intelligence Dashboard

 This file reads data.json and updates the dashboard.
*/

async function loadDashboard() {
  try {
    const response = await fetch("data.json?_=" + Date.now());

    if (!response.ok) {
      throw new Error("data.json could not be loaded");
    }

    const data = await response.json();

    // KPI COUNTS
    setText("news_detected", data.article_count || 0);
    setText("opportunities", data.opportunity_count || 0);
    setText("risks", data.risk_count || 0);
    setText("high_priority", data.high_priority_count || 0);

    // LAST UPDATED
    setText("updated_at", formatTime(data.updated));

    // MUST KNOW
    renderCards("must_know", data.must_know || []);

    // REGIONAL NEWS
    const regions = groupByRegion(data.articles || []);

    renderCards("region_hyderabad", regions.hyderabad);
    renderCards("region_vizag", regions.vizag);
    renderCards("region_india", regions.india);
    renderCards("region_global", regions.global);

    // BUSINESS SIGNALS
    renderSignals("business_signals", data.business_signals || {});

  } catch (error) {
    console.error("Dashboard load failed:", error);
  }
}


// --------------------------------------------------
// GROUP NEWS BY REGION
// --------------------------------------------------

function groupByRegion(articles) {

  const regions = {
    hyderabad: [],
    vizag: [],
    india: [],
    global: []
  };

  articles.forEach(function(item) {

    const category =
      String(item.category || "").toLowerCase();

    if (category.includes("hyderabad")) {

      regions.hyderabad.push(item);

    } else if (
      category.includes("vizag") ||
      category.includes("andhra") ||
      category.includes("ap")
    ) {

      regions.vizag.push(item);

    } else if (category.includes("india")) {

      regions.india.push(item);

    } else {

      regions.global.push(item);

    }

  });

  return regions;
}


// --------------------------------------------------
// RENDER NEWS CARDS
// --------------------------------------------------

function renderCards(fieldName, items) {

  const element =
    document.querySelector(`[data-field="${fieldName}"]`);

  if (!element) {
    return;
  }

  if (!items || items.length === 0) {

    element.innerHTML =
      '<p class="empty">No items in the last 24 hours.</p>';

    return;
  }

  element.innerHTML = items.map(function(item) {

    const signal =
      String(item.signal || "Watch").toLowerCase();

    const title =
      escapeHTML(item.title || "Untitled");

    const link =
      item.link || "#";

    const why =
      escapeHTML(item.why_it_matters || "");

    const action =
      escapeHTML(item.md_action || "");

    return `
      <div class="card">

        <span class="tag tag-${signal}">
          ${escapeHTML(item.signal || "Watch")}
        </span>

        <a
          href="${link}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <strong>${title}</strong>
        </a>

        ${
          why
            ? `<div class="why">
                 <b>Why it matters:</b> ${why}
               </div>`
            : ""
        }

        ${
          action
            ? `<div class="action">
                 <b>MD Action:</b> ${action}
               </div>`
            : ""
        }

      </div>
    `;

  }).join("");
}


// --------------------------------------------------
// BUSINESS SIGNALS
// --------------------------------------------------

function renderSignals(fieldName, signals) {

  const element =
    document.querySelector(`[data-field="${fieldName}"]`);

  if (!element) {
    return;
  }

  const entries =
    Object.entries(signals || {});

  if (entries.length === 0) {

    element.innerHTML =
      '<p class="empty">No business signals available.</p>';

    return;
  }

  const max =
    Math.max(
      1,
      ...entries.map(function(entry) {
        return Number(entry[1]) || 0;
      })
    );

  element.innerHTML = entries.map(function(entry) {

    const label = entry[0];
    const count = Number(entry[1]) || 0;

    const percentage =
      (count / max) * 100;

    return `
      <div class="signal-row">

        <span class="signal-label">
          ${escapeHTML(label)}
        </span>

        <div class="signal-track">
          <div
            class="signal-fill"
            style="width:${percentage}%"
          ></div>
        </div>

        <span class="signal-count">
          ${count}
        </span>

      </div>
    `;

  }).join("");
}


// --------------------------------------------------
// SET TEXT
// --------------------------------------------------

function setText(fieldName, value) {

  const element =
    document.querySelector(`[data-field="${fieldName}"]`);

  if (element) {
    element.textContent = value;
  }
}


// --------------------------------------------------
// FORMAT TIME
// --------------------------------------------------

function formatTime(isoString) {

  if (!isoString) {
    return "";
  }

  const date = new Date(isoString);

  if (isNaN(date.getTime())) {
    return isoString;
  }

  return date.toLocaleString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit"
  });
}


// --------------------------------------------------
// BASIC HTML SAFETY
// --------------------------------------------------

function escapeHTML(value) {

  return String(value)
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}


// --------------------------------------------------
// LOAD DASHBOARD
// --------------------------------------------------

loadDashboard();


// --------------------------------------------------
// REFRESH EVERY 5 MINUTES
// --------------------------------------------------

setInterval(
  loadDashboard,
  5 * 60 * 1000
);
