# ============================================================
# DATE PARSING
# ============================================================

def get_entry_datetime(entry):

    try:

        if entry.get("published_parsed"):

            return datetime(
                *entry.published_parsed[:6],
                tzinfo=timezone.utc
            )

        if entry.get("updated_parsed"):

            return datetime(
                *entry.updated_parsed[:6],
                tzinfo=timezone.utc
            )

    except Exception:
        pass

    for field in ["published", "updated"]:

        value = entry.get(field)

        if value:

            try:

                dt = parsedate_to_datetime(value)

                if dt.tzinfo is None:

                    dt = dt.replace(
                        tzinfo=timezone.utc
                    )

                return dt.astimezone(timezone.utc)

            except Exception:
                pass

    return datetime.now(timezone.utc)


# ============================================================
# FETCH NEWS
# ============================================================

def fetch_news():

    now = datetime.now(timezone.utc)

    cutoff = now - timedelta(
        hours=HOURS_BACK
    )

    articles = []

    seen = set()

    for query in NEWS_QUERIES:

        try:

            feed = feedparser.parse(
                google_news_url(query)
            )

        except Exception as error:

            print(
                "Feed error:",
                query,
                error
            )

            continue

        for entry in feed.entries:

            title = clean_text(
                entry.get("title", "")
            )

            summary = clean_text(
                entry.get("summary", "")
            )

            link = entry.get(
                "link",
                ""
            )

            if not title or not link:
                continue

            published = get_entry_datetime(entry)

            if published < cutoff:
                continue

            source_text = (
                title
                + " "
                + summary
            )

            article_hash = hashlib.sha256(
                (
                    title
                    + link
                ).encode("utf-8")
            ).hexdigest()

            if article_hash in seen:
                continue

            seen.add(article_hash)

            region = detect_region(
                source_text
            )

            category = detect_category(
                source_text
            )

            signal = detect_signal(
                source_text
            )

            article = {

                "title": title,

                "link": link,

                "published": published.isoformat(),

                "category": region,

                "region": region,

                "topic": category,

                "signal": signal,

                "why_it_matters":
                    why_it_matters(
                        category,
                        signal
                    ),

                "md_action":
                    md_action(
                        category,
                        signal
                    )

            }

            articles.append(article)

    articles.sort(
        key=lambda x: x["published"],
        reverse=True
    )

    return articles


# ============================================================
# BUSINESS SIGNALS
# ============================================================

def calculate_business_signals(articles):

    signals = {

        "API / Intermediates": 0,

        "CDMO": 0,

        "Manufacturing": 0,

        "Supply Chain": 0,

        "Regulatory": 0

    }

    for article in articles:

        topic = article.get(
            "topic",
            ""
        )

        if topic == "API / Intermediates":

            signals[
                "API / Intermediates"
            ] += 1

        elif topic == "CDMO / Contract Manufacturing":

            signals[
                "CDMO"
            ] += 1

        elif topic == "Manufacturing / Plants":

            signals[
                "Manufacturing"
            ] += 1

        elif topic == "Supply Chain":

            signals[
                "Supply Chain"
            ] += 1

        elif topic == "Regulatory":

            signals[
                "Regulatory"
            ] += 1

    return signals


# ============================================================
# BUILD DASHBOARD DATA
# ============================================================

def build_dashboard_data(articles):

    opportunities = [
        article
        for article in articles
        if article["signal"] == "Opportunity"
    ]

    risks = [
        article
        for article in articles
        if article["signal"] == "Risk"
    ]

    high_priority = [
        article
        for article in articles
        if (
            article["signal"] == "Risk"
            or (
                article["signal"] == "Opportunity"
                and article["topic"]
                in [
                    "Investment / Expansion",
                    "API / Intermediates",
                    "CDMO / Contract Manufacturing"
                ]
            )
        )
    ]

    must_know = high_priority[:5]

    return {

        "company":
            "Sri Aditya Pharmachem",

        "dashboard":
            "MD Pharma Intelligence",

        "updated":
            datetime.now(
                timezone.utc
            ).isoformat(),

        "article_count":
            len(articles),

        "opportunity_count":
            len(opportunities),

        "risk_count":
            len(risks),

        "high_priority_count":
            len(high_priority),

        "must_know":
            must_know,

        "articles":
            articles,

        "business_signals":
            calculate_business_signals(
                articles
            )

    }


# ============================================================
# SAVE JSON
# ============================================================

def save_json(data):

    with open(
        OUTPUT_FILE,
        "w",
        encoding="utf-8"
    ) as file:

        json.dump(
            data,
            file,
            indent=2,
            ensure_ascii=False
        )


