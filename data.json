# ============================================================
# GOOGLE NEWS RSS
# ============================================================

def google_news_url(query):

    encoded = quote(query)

    return (
        "https://news.google.com/rss/search?"
        f"q={encoded}"
        "&hl=en-IN"
        "&gl=IN"
        "&ceid=IN:en"
    )


# ============================================================
# TEXT HELPERS
# ============================================================

def clean_text(text):

    if not text:
        return ""

    text = re.sub(r"<[^>]+>", " ", text)
    text = re.sub(r"\s+", " ", text)

    return text.strip()


def contains_keyword(text, keywords):

    text = text.lower()

    return any(
        keyword.lower() in text
        for keyword in keywords
    )


# ============================================================
# REGION
# ============================================================

def detect_region(text):

    text = text.lower()

    if (
        "hyderabad" in text
        or "telangana" in text
    ):
        return "Hyderabad"

    if (
        "vizag" in text
        or "visakhapatnam" in text
        or "andhra pradesh" in text
        or "andhra" in text
    ):
        return "Vizag / AP"

    india_terms = [
        "india",
        "indian",
        "new delhi",
        "mumbai",
        "ahmedabad",
        "chennai",
        "bengaluru",
        "bangalore",
        "pune",
    ]

    if any(term in text for term in india_terms):
        return "India"

    return "Global"


# ============================================================
# CATEGORY
# ============================================================

def detect_category(text):

    if contains_keyword(text, API_KEYWORDS):
        return "API / Intermediates"

    if contains_keyword(text, CDMO_KEYWORDS):
        return "CDMO / Contract Manufacturing"

    if contains_keyword(text, INVESTMENT_KEYWORDS):
        return "Investment / Expansion"

    if contains_keyword(text, MANUFACTURING_KEYWORDS):
        return "Manufacturing / Plants"

    if contains_keyword(text, REGULATORY_KEYWORDS):
        return "Regulatory"

    if contains_keyword(text, SUPPLY_CHAIN_KEYWORDS):
        return "Supply Chain"

    return "Pharma Industry"


# ============================================================
# SIGNAL
# ============================================================

def detect_signal(text):

    if contains_keyword(text, RISK_KEYWORDS):

        return "Risk"

    if contains_keyword(text, OPPORTUNITY_KEYWORDS):

        return "Opportunity"

    return "Watch"


