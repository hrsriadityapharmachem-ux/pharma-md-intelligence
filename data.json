# MAIN
# ============================================================

def main():

    print(
        "Sri Aditya Pharmachem "
        "MD Intelligence starting..."
    )

    articles = fetch_news()

    print(
        "Articles found:",
        len(articles)
    )

    data = build_dashboard_data(
        articles
    )

    save_json(data)

    print(
        "data.json updated successfully."
    )

    print(
        "Opportunities:",
        data["opportunity_count"]
    )

    print(
        "Risks:",
        data["risk_count"]
    )

    print(
        "High priority:",
        data["high_priority_count"]
    )


if __name__ == "__main__":

    main()
